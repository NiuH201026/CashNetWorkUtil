<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 允许所有 HTTP 流量（仅测试用） -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <!-- 允许用户安装的证书 -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- 或者针对特定域名 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">ws.postman-echo.com</domain>
        <domain includeSubdomains="true">echo.websocket.org</domain>
    </domain-config>

    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">glaya.shop</domain>
        <domain includeSubdomains="true">cdn.glaya.shop</domain>
        <!-- 信任自定义证书或放宽验证 -->
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>